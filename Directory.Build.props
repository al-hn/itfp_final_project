<Project>
  <!-- Single place to change the target framework. Use the major version of your installed SDK (net8.0, net9.0, net10.0). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
</Project>
